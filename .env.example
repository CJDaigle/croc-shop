# Copy to .env and update values for local development.
# This file is an example; the real .env is gitignored.

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Service DB credentials
DB_USER=postgres
DB_PASSWORD=postgres

# JWT signing secret (use a strong random value in any shared environment)
JWT_SECRET=dev-secret-change-in-production

# AWS / Bedrock gateway settings for the chatbot service
AWS_REGION=us-east-1
CHATBOT_API_TOKEN=200
BEDROCK_GATEWAY_URL=https://us.gateway.aidefense.security.cisco.com/fe399c8a-8aa7-41a9-b64e-a6a8a04ab49f/connections/5bf35e34-c75f-40b8-bae0-d0083e39cbcc/model/us.anthropic.claude-sonnet-4-20250514-v1:0/converse-stream
